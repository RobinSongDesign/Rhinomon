<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Rhino plug-ins are .rhp files (renamed .dll). -->
    <TargetExt>.rhp</TargetExt>
    <Version>0.2.0</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>Rhinomon</Company>
    <Product>Rhinomon</Product>
    <Description>A tiny pixel pet living in your Rhino viewport.</Description>
    <!-- RhinoCommon.dll is provided by the Rhino installation at runtime. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- net7.0 matches Rhino 8's bundled runtime; keep newer SDKs from raising
         end-of-life TFM warnings so the build stays warning-free everywhere. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- Pinned to the oldest Rhino 8 SDK on purpose: Yak derives the package's
         minimum Rhino version from the RhinoCommon the plug-in references, so
         this is what makes the package install on every Rhino 8 ("rh8_0").
         Building against it also proves no newer-only API crept in. Override
         with -p:RhinoCommonVersion=8.* to try the latest SDK. -->
    <RhinoCommonVersion Condition="'$(RhinoCommonVersion)' == ''">8.0.23304.9001</RhinoCommonVersion>
  </PropertyGroup>

  <!-- The 8.0 package only ships a net48 lib; it is a compile-time reference
       (Rhino supplies RhinoCommon at runtime), so the framework-fallback
       notice NU1701 is expected and silenced. -->
  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="$(RhinoCommonVersion)" ExcludeAssets="runtime" NoWarn="NU1701" />
  </ItemGroup>

  <!-- Sprite sheets generated by tools/spritegen. Wildcards keep the build
       working while the assets directory is still empty. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\*.png" Link="Assets\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\assets\atlas.json" Link="Assets\atlas.json" Condition="Exists('..\..\assets\atlas.json')" />
  </ItemGroup>

</Project>
